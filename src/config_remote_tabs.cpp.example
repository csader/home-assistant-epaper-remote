#include "config_remote.h"
#include "assets/icons.h"
#include "boards.h"
#include "config.h"
#include "screen.h"
#include "store.h"

// Tab navigation configuration example
// Copy this file to config_remote.cpp and customize for your setup
//
// Navigation: Text tabs appear at the bottom of the screen.
// Tap a tab label to jump directly to that page.

void configure_remote(Configuration* config, EntityStore* store, ScreenManager* screens) {
    // =========================================================================
    // WiFi Configuration
    // =========================================================================
    config->wifi_ssid = "MyWifiSSID";
    config->wifi_password = "my-wifi-password1234!";

    // =========================================================================
    // Home Assistant Configuration
    // =========================================================================
    // If you're using https, use wss://, otherwise use ws://
    config->home_assistant_url = "ws://192.168.0.1/api/websocket";
    config->home_assistant_token = "ey...";
    config->root_ca = ISRG_ROOT_X1; // You probably don't need to update this

    // =========================================================================
    // Navigation Mode: Tabs
    // =========================================================================
    screen_manager_set_nav_mode(screens, NavigationMode::Tabs);

    // =========================================================================
    // Entity Declarations
    // =========================================================================

    // Lights
    EntityConfig living_room_lights = {
        .entity_id = "light.living_room",
        .command_type = CommandType::SetLightBrightnessPercentage,
    };
    EntityConfig bedroom_lights = {
        .entity_id = "light.bedroom",
        .command_type = CommandType::SetLightBrightnessPercentage,
    };

    // Covers & Fans
    EntityConfig bedroom_shades = {
        .entity_id = "cover.bedroom_shades",
        .command_type = CommandType::SetCoverPosition,
    };
    EntityConfig ceiling_fan = {
        .entity_id = "fan.ceiling_fan",
        .command_type = CommandType::SetFanSpeedPercentage,
    };

    // Media & Scenes
    EntityConfig speaker_volume = {
        .entity_id = "media_player.living_room_speaker",
        .command_type = CommandType::SetMediaPlayerVolume,
    };
    EntityConfig tv_play_pause = {
        .entity_id = "media_player.living_room_tv",
        .command_type = CommandType::MediaPlayerPlayPause,
    };
    EntityConfig movie_scene = {
        .entity_id = "scene.movie_time",
        .command_type = CommandType::ActivateScene,
    };
    EntityConfig morning_routine = {
        .entity_id = "script.morning_routine",
        .command_type = CommandType::RunScript,
    };

    // Security & Automations
    EntityConfig front_door = {
        .entity_id = "lock.front_door",
        .command_type = CommandType::LockUnlock,
    };
    EntityConfig night_mode = {
        .entity_id = "automation.night_mode",
        .command_type = CommandType::AutomationOnOff,
    };

    // =========================================================================
    // PAGE 1: Lights
    // The second parameter to screen_manager_add_page is the tab label
    // =========================================================================
    Screen* page1 = screen_manager_add_page(screens, "Lights");

    screen_add_slider(
        SliderConfig{
            .entity_ref = store_add_entity(store, living_room_lights),
            .label = "Living Room",
            .icon_on = lightbulb_outline,
            .icon_off = lightbulb_off_outline,
            .pos_x = 30,
            .pos_y = 30,
            .width = DISPLAY_WIDTH - 60,
            .height = 170,
        },
        page1);

    screen_add_slider(
        SliderConfig{
            .entity_ref = store_add_entity(store, bedroom_lights),
            .label = "Bedroom",
            .icon_on = lightbulb_outline,
            .icon_off = lightbulb_off_outline,
            .pos_x = 30,
            .pos_y = 220,
            .width = DISPLAY_WIDTH - 60,
            .height = 170,
        },
        page1);

    // =========================================================================
    // PAGE 2: Climate
    // =========================================================================
    Screen* page2 = screen_manager_add_page(screens, "Climate");

    screen_add_slider(
        SliderConfig{
            .entity_ref = store_add_entity(store, bedroom_shades),
            .label = "Shades",
            .icon_on = blinds_open,
            .icon_off = blinds,
            .pos_x = 30,
            .pos_y = 30,
            .width = DISPLAY_WIDTH - 60,
            .height = 170,
        },
        page2);

    screen_add_slider(
        SliderConfig{
            .entity_ref = store_add_entity(store, ceiling_fan),
            .label = "Ceiling Fan",
            .icon_on = fan,
            .icon_off = fan_off,
            .pos_x = 30,
            .pos_y = 220,
            .width = DISPLAY_WIDTH - 60,
            .height = 170,
        },
        page2);

    screen_add_slider(
        SliderConfig{
            .entity_ref = store_add_entity(store, speaker_volume),
            .label = "Volume",
            .icon_on = volume_high,
            .icon_off = volume_low,
            .pos_x = 30,
            .pos_y = 410,
            .width = DISPLAY_WIDTH - 60,
            .height = 170,
        },
        page2);

    // =========================================================================
    // PAGE 3: Controls
    // =========================================================================
    Screen* page3 = screen_manager_add_page(screens, "Controls");

    screen_add_button(
        ButtonConfig{
            .entity_ref = store_add_entity(store, movie_scene),
            .label = "Movie",
            .icon_on = movie,
            .icon_off = movie,
            .pos_x = 30,
            .pos_y = 30,
        },
        page3);

    screen_add_button(
        ButtonConfig{
            .entity_ref = store_add_entity(store, morning_routine),
            .label = "Morning",
            .icon_on = weather_sunny,
            .icon_off = weather_sunny,
            .pos_x = 150,
            .pos_y = 30,
        },
        page3);

    screen_add_button(
        ButtonConfig{
            .entity_ref = store_add_entity(store, front_door),
            .label = "Door",
            .icon_on = lock,
            .icon_off = lock_open,
            .pos_x = 270,
            .pos_y = 30,
        },
        page3);

    screen_add_button(
        ButtonConfig{
            .entity_ref = store_add_entity(store, tv_play_pause),
            .label = "TV",
            .icon_on = play,
            .icon_off = pause,
            .pos_x = 390,
            .pos_y = 30,
        },
        page3);

    screen_add_button(
        ButtonConfig{
            .entity_ref = store_add_entity(store, night_mode),
            .label = "Night",
            .icon_on = weather_night,
            .icon_off = weather_night,
            .pos_x = 30,
            .pos_y = 150,
        },
        page3);
}
